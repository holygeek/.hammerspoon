#!/opt/local/bin/hs
-- vim:ft=lua

local appName = "Chrome"
local chromeWindows = {}
local chrome = hs.application.find(appName)
for i, v in ipairs(chrome:allWindows()) do
	local title = v:title()
	if #title > 0 then
		local i, j, windowName = string.find(title, '%[([^%]]+)%]')
		if windowName ~= nil and #windowName > 0 then
			local tl = v:topLeft()
			local sz = v:size()
			table.insert(chromeWindows, {
				name = windowName,
				x = tl.x,
				y = tl.y,
				w = sz.w,
				h = sz.h
			})
		end
	end
end

if #chromeWindows > 0 then
	local home = os.getenv('HOME')
	local filename = home .. '/.hammerspoon/.windows.' .. appName .. '.new'
	local file = assert(io.open(filename, 'w'))
	for i=1,#chromeWindows do
		local w = chromeWindows[i]
		-- print(w.name, w.x, w.y, w.h, w.w)
		-- print(string.format("%d %d %d %d %s", w.x, w.y, w.h, w.w, w.name))
		file:write(string.format("%d %d %d %d %s\n", w.x, w.y, w.w, w.h, w.name))
	end
	file:flush()
	file:close()
end
